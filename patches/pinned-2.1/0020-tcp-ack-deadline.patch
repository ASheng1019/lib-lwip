+/* Optional ACK deadline independent of the 250/500ms TCP clocks. */
+#ifndef LWIP_TCP_ACK_DELAY_MS
+#define LWIP_TCP_ACK_DELAY_MS 0
+#endif
+#if LWIP_TCP_ACK_DELAY_MS
+#if !LWIP_TIMERS || LWIP_TCP_ACK_DELAY_MS < 1 ||                               \
+    LWIP_TCP_ACK_DELAY_MS >= TCP_FAST_INTERVAL
+#error "ACK deadline requires timers and must be below TCP_FAST_INTERVAL"
+#endif
+void tcp_ack_delay_start(void);
+#else
+#define tcp_ack_delay_start() ((void)0)
+#endif
+
+#define tcp_ack(pcb)                                                           \
+  do {                                                                         \
+    if ((pcb)->flags & TF_ACK_DELAY) {                                         \
+      tcp_clear_flags(pcb, TF_ACK_DELAY);                                      \
+      tcp_ack_now(pcb);                                                        \
+    } else {                                                                   \
+      tcp_set_flags(pcb, TF_ACK_DELAY);                                        \
+      tcp_ack_delay_start();                                                   \
+    }                                                                          \
   } while (0)
 
 #define tcp_ack_now(pcb)                           \
