@@ -230,6 +231,36 @@
 /**
  * Called periodically to dispatch TCP timers.
  */
+#if LWIP_TCP_ACK_DELAY_MS
+/* One stack-wide timeout, no PCB lifetime tied to a timeout argument. All
+ * operations run on the TCP core. Empty ACK output invokes no user callback.
+ * The historical fast timer remains the allocation-pressure fallback. */
+static u8_t tcp_ack_delay_armed;
+static void tcp_ack_delay_timeout(void *arg)
+{
+  struct tcp_pcb *pcb;
+  LWIP_UNUSED_ARG(arg);
+  LWIP_ASSERT_CORE_LOCKED();
+  tcp_ack_delay_armed = 0;
+  for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
+    if (pcb->flags & TF_ACK_DELAY) {
+      if (tcp_send_empty_ack(pcb) != ERR_OK) {
+        tcp_ack_delay_start();
+      }
+    }
+  }
+}
+
+void tcp_ack_delay_start(void)
+{
+  LWIP_ASSERT_CORE_LOCKED();
+  if (!tcp_ack_delay_armed) {
+    tcp_ack_delay_armed = 1;
+    sys_timeout(LWIP_TCP_ACK_DELAY_MS, tcp_ack_delay_timeout, NULL);
+  }
+}
+#endif
+
 void
 tcp_tmr(void)
 {
