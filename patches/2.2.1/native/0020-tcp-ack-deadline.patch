From fbf7b9f8ee537c9f44d06505bd28b0513df596ca Mon Sep 17 00:00:00 2001
From: Sheng <hsdai22@m.fudan.edu.cn>
Date: Thu, 22 Oct 2026 18:34:17 +0800
Subject: [PATCH] Provide a configurable TCP ACK deadline independent of slow
 timers

Unikraft integration on lwIP 2.2.1, retaining upstream IPV6_CHECKSUM handling and native-aware address bounds.
---
 src/core/tcp.c                   | 44 ++++++++++++++++++++++++++++++++
 src/core/tcp_out.c               |  2 ++
 src/include/lwip/priv/tcp_priv.h | 32 ++++++++++++++++-------
 3 files changed, 69 insertions(+), 9 deletions(-)

diff --git a/src/core/tcp.c b/src/core/tcp.c
index ea95ffee..18ff66bd 100644
--- a/src/core/tcp.c
+++ b/src/core/tcp.c
@@ -108,6 +108,7 @@
 #include "lwip/priv/tcp_priv.h"
 #include "lwip/debug.h"
 #include "lwip/stats.h"
+#include "lwip/timeouts.h"
 #include "lwip/ip6.h"
 #include "lwip/ip6_addr.h"
 #include "lwip/nd6.h"
@@ -230,6 +231,36 @@ tcp_free_listen(struct tcp_pcb *pcb)
 /**
  * Called periodically to dispatch TCP timers.
  */
+#if LWIP_TCP_ACK_DELAY_MS
+/* One stack-wide timeout, no PCB lifetime tied to a timeout argument. All
+ * operations run on the TCP core. Empty ACK output invokes no user callback.
+ * The historical fast timer remains the allocation-pressure fallback. */
+static u8_t tcp_ack_delay_armed;
+static void tcp_ack_delay_timeout(void *arg)
+{
+  struct tcp_pcb *pcb;
+  LWIP_UNUSED_ARG(arg);
+  LWIP_ASSERT_CORE_LOCKED();
+  tcp_ack_delay_armed = 0;
+  for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
+    if (pcb->flags & TF_ACK_DELAY) {
+      if (tcp_send_empty_ack(pcb) != ERR_OK) {
+        tcp_ack_delay_start();
+      }
+    }
+  }
+}
+
+void tcp_ack_delay_start(void)
+{
+  LWIP_ASSERT_CORE_LOCKED();
+  if (!tcp_ack_delay_armed) {
+    tcp_ack_delay_armed = 1;
+    sys_timeout(LWIP_TCP_ACK_DELAY_MS, tcp_ack_delay_timeout, NULL);
+  }
+}
+#endif
+
 void
 tcp_tmr(void)
 {
@@ -1484,6 +1515,11 @@ tcp_fasttmr(void)
 {
   struct tcp_pcb *pcb;
 
+#if LWIP_TCP_ACK_DELAY_MS
+  /* Also recover if sys_timeout could not allocate its bounded timer. */
+  sys_untimeout(tcp_ack_delay_timeout, NULL);
+  tcp_ack_delay_armed = 0;
+#endif
   ++tcp_timer_ctr;
 
 tcp_fasttmr_start:
@@ -1497,8 +1533,16 @@ tcp_fasttmr_start:
       if (pcb->flags & TF_ACK_DELAY) {
         LWIP_DEBUGF(TCP_DEBUG, ("tcp_fasttmr: delayed ACK\n"));
         tcp_ack_now(pcb);
+#if LWIP_TCP_ACK_DELAY_MS
+        if (tcp_output(pcb) == ERR_OK) {
+          tcp_clear_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
+        } else {
+          tcp_ack_delay_start();
+        }
+#else
         tcp_output(pcb);
         tcp_clear_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
+#endif
       }
       /* send pending FIN */
       if (pcb->flags & TF_CLOSEPEND) {
diff --git a/src/core/tcp_out.c b/src/core/tcp_out.c
index cfcc55dd..550f3a9d 100644
--- a/src/core/tcp_out.c
+++ b/src/core/tcp_out.c
@@ -2113,6 +2113,7 @@ tcp_send_empty_ack(struct tcp_pcb *pcb)
   if (p == NULL) {
     /* let tcp_fasttmr retry sending this ACK */
     tcp_set_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
+    tcp_ack_delay_start();
     LWIP_DEBUGF(TCP_OUTPUT_DEBUG, ("tcp_output: (ACK) could not allocate pbuf\n"));
     return ERR_BUF;
   }
@@ -2128,6 +2129,7 @@ tcp_send_empty_ack(struct tcp_pcb *pcb)
   if (err != ERR_OK) {
     /* let tcp_fasttmr retry sending this ACK */
     tcp_set_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
+    tcp_ack_delay_start();
   } else {
     /* remove ACK flags from the PCB, as we sent an empty ACK now */
     tcp_clear_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
diff --git a/src/include/lwip/priv/tcp_priv.h b/src/include/lwip/priv/tcp_priv.h
index a8e87e59..89271459 100644
--- a/src/include/lwip/priv/tcp_priv.h
+++ b/src/include/lwip/priv/tcp_priv.h
@@ -442,15 +442,29 @@ void tcp_segs_free(struct tcp_seg *seg);
 void tcp_seg_free(struct tcp_seg *seg);
 struct tcp_seg *tcp_seg_copy(struct tcp_seg *seg);
 
-#define tcp_ack(pcb)                               \
-  do {                                             \
-    if((pcb)->flags & TF_ACK_DELAY) {              \
-      tcp_clear_flags(pcb, TF_ACK_DELAY);          \
-      tcp_ack_now(pcb);                            \
-    }                                              \
-    else {                                         \
-      tcp_set_flags(pcb, TF_ACK_DELAY);            \
-    }                                              \
+/* Optional ACK deadline independent of the 250/500ms TCP clocks. */
+#ifndef LWIP_TCP_ACK_DELAY_MS
+#define LWIP_TCP_ACK_DELAY_MS 0
+#endif
+#if LWIP_TCP_ACK_DELAY_MS
+#if !LWIP_TIMERS || LWIP_TCP_ACK_DELAY_MS < 1 ||                               \
+    LWIP_TCP_ACK_DELAY_MS >= TCP_FAST_INTERVAL
+#error "ACK deadline requires timers and must be below TCP_FAST_INTERVAL"
+#endif
+void tcp_ack_delay_start(void);
+#else
+#define tcp_ack_delay_start() ((void)0)
+#endif
+
+#define tcp_ack(pcb)                                                           \
+  do {                                                                         \
+    if ((pcb)->flags & TF_ACK_DELAY) {                                         \
+      tcp_clear_flags(pcb, TF_ACK_DELAY);                                      \
+      tcp_ack_now(pcb);                                                        \
+    } else {                                                                   \
+      tcp_set_flags(pcb, TF_ACK_DELAY);                                        \
+      tcp_ack_delay_start();                                                   \
+    }                                                                          \
   } while (0)
 
 #define tcp_ack_now(pcb)                           \
