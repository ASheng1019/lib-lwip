From: Sheng <hsdai22@m.fudan.edu.cn>
Date: Thu, 22 Oct 2026 18:32:12 +0800
Subject: [PATCH] 0013-allow-more-sockets-than-select

Rebased Unikraft adaptation for lwIP 2.2.1.
---
 src/include/lwip/sockets.h | 2 --
 1 file changed, 2 deletions(-)

diff --git a/src/include/lwip/sockets.h b/src/include/lwip/sockets.h
index 46a8c072..d6144a82 100644
--- a/src/include/lwip/sockets.h
+++ b/src/include/lwip/sockets.h
@@ -86,8 +86,6 @@ typedef struct fd_set
   unsigned char fd_bits [(FD_SETSIZE+7)/8];
 } fd_set;
 
-#elif FD_SETSIZE < (LWIP_SOCKET_OFFSET + MEMP_NUM_NETCONN)
-#error "external FD_SETSIZE too small for number of sockets"
 #else
 #define LWIP_SELECT_MAXNFDS FD_SETSIZE
 #endif /* FD_SET */
