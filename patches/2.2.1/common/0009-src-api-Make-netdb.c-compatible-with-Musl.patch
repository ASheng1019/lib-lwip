From 1846600bda7acb379b3a35abacb48c7fc4b36e2f Mon Sep 17 00:00:00 2001
From: Razvan Deaconescu <razvand@unikraft.io>
Date: Thu, 22 Oct 2026 18:31:41 +0800
Subject: [PATCH] src/api: Make netdb.c compatible with Musl

Rebased Unikraft adaptation for lwIP 2.2.1; retain native-aware upstream address bounds.
---
 src/api/netdb.c | 20 ++------------------
 1 file changed, 2 insertions(+), 18 deletions(-)

diff --git a/src/api/netdb.c b/src/api/netdb.c
index 73028c8e..110dc6dc 100644
--- a/src/api/netdb.c
+++ b/src/api/netdb.c
@@ -57,18 +57,8 @@ struct gethostbyname_r_helper {
   char *aliases;
 };
 
-/** h_errno is exported in netdb.h for access by applications. */
-#if LWIP_DNS_API_DECLARE_H_ERRNO
-int h_errno;
-#endif /* LWIP_DNS_API_DECLARE_H_ERRNO */
-
-/** LWIP_DNS_API_HOSTENT_STORAGE: if set to 0 (default), lwip_gethostbyname()
- * returns the same global variable for all calls (in all threads).
- * When set to 1, your port should provide a function
- *      struct hostent* sys_thread_hostent( struct hostent* h);
- * which have to do a copy of "h" and return a pointer ont the "per-thread"
- * copy.
- */
+/** define "hostent" variables storage: 0 if we use a static (but unprotected)
+ * set of variables for lwip_gethostbyname, 1 if we use a local storage */
 #ifndef LWIP_DNS_API_HOSTENT_STORAGE
 #define LWIP_DNS_API_HOSTENT_STORAGE 0
 #endif
@@ -383,9 +373,6 @@ lwip_getaddrinfo(const char *nodename, const char *servname,
     /* set up sockaddr */
     inet6_addr_from_ip6addr(&sa6->sin6_addr, ip_2_ip6(&addr));
     sa6->sin6_family = AF_INET6;
-#if LWIP_SOCKET_HAVE_SA_LEN
-    sa6->sin6_len = sizeof(struct sockaddr_in6);
-#endif /* LWIP_SOCKET_HAVE_SA_LEN */
     sa6->sin6_port = lwip_htons((u16_t)port_nr);
     sa6->sin6_scope_id = ip6_addr_zone(ip_2_ip6(&addr));
     ai->ai_family = AF_INET6;
@@ -396,9 +383,6 @@ lwip_getaddrinfo(const char *nodename, const char *servname,
     /* set up sockaddr */
     inet_addr_from_ip4addr(&sa4->sin_addr, ip_2_ip4(&addr));
     sa4->sin_family = AF_INET;
-#if LWIP_SOCKET_HAVE_SA_LEN
-    sa4->sin_len = sizeof(struct sockaddr_in);
-#endif /* LWIP_SOCKET_HAVE_SA_LEN */
     sa4->sin_port = lwip_htons((u16_t)port_nr);
     ai->ai_family = AF_INET;
 #endif /* LWIP_IPV4 */
